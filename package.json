{
  "name": "dsh-input-suggest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "输入框智能建议：每轮回合结束后用指定的辅助模型预测下一条提示词，以灰色幽灵文字填进输入框；Tab 采纳，独立「重随」按钮重新生成，提示词与风格可自定义。零会话日志写入。",
  "homepage": "https://github.com/yibiny824-code/dsh-input-suggest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yibiny824-code/dsh-input-suggest.git"
  },
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client.js",
    "test",
    "tools",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --import ./test/resolve-host.mjs test/self-test.mjs",
    "test:memory": "node --import ./test/resolve-host.mjs test/memory-privacy.mjs",
    "test:host": "node --import ./test/resolve-host.mjs test/real-cordis.mjs",
    "test:storage": "node --import ./test/resolve-host.mjs test/e2e-storage.mjs",
    "test:schema": "node --import ./test/resolve-host.mjs test/config-schema.mjs",
    "status": "node tools/desktop-profile.mjs status",
    "install-plugin": "node tools/desktop-profile.mjs install",
    "uninstall-plugin": "node tools/desktop-profile.mjs uninstall"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "suggestion",
    "composer",
    "desktop-ui"
  ]
}
