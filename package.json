{
  "name": "dsh-input-suggest",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 任务感知型输入建议。按任务进度生成一条可用 Tab 采纳的下一步指令，支持独立辅助模型、提示词、本地反馈与 Token 账本。",
  "homepage": "https://github.com/yibiny824-code/dsh-input-suggest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yibiny824-code/dsh-input-suggest.git"
  },
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client.js",
    "test",
    "tools",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --import ./test/resolve-host.mjs test/self-test.mjs",
    "test:install": "node test/install-shape.mjs",
    "test:memory": "node --import ./test/resolve-host.mjs test/memory-privacy.mjs",
    "test:usage": "node test/usage.mjs",
    "test:feedback": "node --import ./test/resolve-host.mjs test/feedback.mjs",
    "test:task": "node test/task-state.mjs",
    "test:access": "node --import ./test/resolve-host.mjs test/access.mjs",
    "test:suggestion-config": "node --import ./test/resolve-host.mjs test/suggestion-config.mjs",
    "test:agent-tool": "node --import ./test/resolve-host.mjs test/agent-tool.mjs",
    "test:host": "node --import ./test/resolve-host.mjs test/real-cordis.mjs",
    "test:storage": "node --import ./test/resolve-host.mjs test/e2e-storage.mjs",
    "test:schema": "node --import ./test/resolve-host.mjs test/config-schema.mjs",
    "status": "node tools/desktop-profile.mjs status",
    "install-plugin": "node tools/desktop-profile.mjs install",
    "uninstall-plugin": "node tools/desktop-profile.mjs uninstall"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "suggestion",
    "composer",
    "desktop-ui"
  ]
}
